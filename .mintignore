# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Reference workflow JSONs (for AI agents and developers, not published)
scenarios/

# Brand assets (source files, not published)
worlds-branding/

# Training doc authoring template (for writers, not published)
worlds-training-docs/

# Internal agent instructions (not published)
CLAUDE.md
AGENTS.md

# Mintlify starter boilerplate (reference only, not published)
essentials/
api-reference/
snippets/
quickstart.mdx
development.mdx
